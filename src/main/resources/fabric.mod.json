{
  "schemaVersion": 1,
  "id": "steamdeck_essentials",
  "version": "${version}",
  "name": "SteamDeck Essentials",
  "description": "Steam Deck optimization mod with automatic handheld/desktop mode: battery life maximization (handheld only), native Steam Deck & Steam Controller engine without Steam, contextual gyro-aiming, touch OSK & handheld GUI fixes.",
  "authors": [
    "lukhicken"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/steamdeck_essentials/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.steamdeck.mc.SteamDeckEssentials"
    ],
    "modmenu": [
      "com.steamdeck.mc.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "steamdeck_essentials.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
